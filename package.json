{
  "name": "teste1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check": "run-s format:check lint type-check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,tsx,vue}": [
      "prettier --write",
      "eslint --fix --cache"
    ],
    "*.{js,json,css,md,html}": "prettier --write"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "katex": "^0.18.4",
    "pinia": "^3.0.4",
    "v-network-graph": "^0.9.22",
    "vue": "^3.5.30",
    "vue-mathjax-next": "^0.0.6",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
